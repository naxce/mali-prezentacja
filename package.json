{
  "name": "mali-prezentacja",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Adam Pietrzak",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env --watch server/main.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "e2e": "playwright test",
    "package": "node scripts/package.ts",
    "media": "node scripts/fetch-media.ts",
    "maps": "node scripts/build-maps.ts",
    "pdf": "node scripts/export-pdf.ts",
    "previews": "node scripts/readme-previews.ts",
    "bots": "node scripts/bot-sim.ts"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
